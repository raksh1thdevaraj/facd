[run]
source = app
omit =
    */tests/*
    */alembic/*
    */scripts/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG:
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
show_missing = True
fail_under = 80
