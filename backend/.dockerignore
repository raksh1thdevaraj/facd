# Git
.git
.gitignore

# Python virtual environments and caches
.venv
venv
env
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Storage uploads and local artifacts
storage/uploads/*
storage/preprocessed/*
storage/reports/*
!storage/uploads/.gitkeep
!storage/preprocessed/.gitkeep
!storage/reports/.gitkeep

# Local SQLite databases
*.db
*.sqlite
*.sqlite3

# IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db
