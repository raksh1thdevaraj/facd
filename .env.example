# ==============================================================================
# AI-Based Detection of Fake or Manipulated Academic Certificates
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Certificate Verification Engine"
API_V1_STR="/api/v1"

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-strong-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local SQLite for development / Pytest: sqlite:///./dev.db
# PostgreSQL for production: postgresql://postgres:postgres@localhost:5432/cert_verification_db
DATABASE_URL=sqlite:///./dev.db
DB_ECHO=False

# Asynchronous Task Queue & Cache
REDIS_URL=redis://localhost:6379/0
USE_ASYNC_CELERY=False

# Storage File Paths (Relative to project root or Absolute)
STORAGE_BASE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PREPROCESSED_DIR=./storage/preprocessed
REPORT_DIR=./storage/reports
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB

# OCR Engine Configuration (paddleocr, easyocr, tesseract)
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
TESSERACT_CMD=tesseract

# Machine Learning & Deep Learning
MODEL_DIR=./ml/models
MODEL_VERSION=v1.0
DEVICE=cpu # 'cpu', 'cuda', or 'mps'

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
