rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'ADMIN'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email.matches('.*admin@.*')
      );
    }

    function isVerifier() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role in ['institution_verifier', 'verifier', 'INSTITUTION_VERIFIER'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Allow read so unauthenticated clients can resolve username -> email and verifier profiles
      allow read: if true;
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role in ['user', 'admin', 'student', 'PUBLIC_USER'] ||
        isAdmin()
      );
      allow update: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isAdmin();
      allow delete: if isAdmin();
    }

    // 1b. Admins Collection (Role discovery)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Certificates Collection
    // Read: Owner UID, designated verifier, or admin
    // Create: Allowed for client with initial status 'queued'
    // Update/Delete: Disallowed from client. Only Cloud Functions / Admin SDK can mutate verification states
    match /certificates/{certId} {
      allow read: if isAuthenticated() && (
        resource.data.uploaderUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isVerifier()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.uploaderUid == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      ) && (
        !('status' in request.resource.data) || request.resource.data.status == 'queued'
      );
      allow update: if false; // Only Cloud Functions (Admin SDK) or verifyCertificateManualReview can update
      allow delete: if isAdmin();
    }

    // 3. Fraud Reports Collection
    // Read: Restricted to verifiers and admins only (students cannot inspect fraud vector logic directly)
    // Write: Disallowed for all clients (only backend Cloud Functions via Admin SDK can mutate)
    match /fraud_reports/{certificateId} {
      allow read: if isAuthenticated() && isVerifier();
      allow write: if false;
    }

    // 4. Audit Logs Collection
    // Immutable verification trails: read-only for auditors/admins, written only by Admin SDK
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isVerifier();
      allow write: if false;
    }

    // 5. Course Verifications Collection (Historical/Course Pipeline Records)
    match /course_verifications/{verificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isVerifier()
      );
      allow write: if false;
    }

    // 6. University Marks Card Verifications Collection (Enterprise Audit Ledger)
    match /verifications/{verificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() && isVerifier();
      allow delete: if isAdmin();
    }
  }
}
