# ==============================================================================
# Production Environment Configuration Template
# WARNING: NEVER commit actual production secrets to source control.
# Copy this file to .env.production and populate with secure generated secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
APP_NAME="AI Certificate Verification Engine"
API_V1_STR="/api/v1"

# Server Bindings (Container internal)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=4

# Production Public FQDN / Frontend Origin
FRONTEND_URL=https://certcheck.example.com
CORS_ORIGINS=https://certcheck.example.com

# Cryptographic Security
# Generate secure 64-char key using: python scripts/generate_secrets.py
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production PostgreSQL Database
POSTGRES_DB=cert_verification_prod
POSTGRES_USER=cert_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://cert_admin:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/cert_verification_prod
DB_ECHO=False

# Redis Cache & Asynchronous Broker
REDIS_URL=redis://redis:6379/0
USE_ASYNC_CELERY=False

# Storage File Paths
STORAGE_BASE_DIR=/app/storage
UPLOAD_DIR=/app/storage/uploads
PREPROCESSED_DIR=/app/storage/preprocessed
REPORT_DIR=/app/storage/reports
TEMPLATES_DIR=/app/storage/templates
MAX_UPLOAD_SIZE_BYTES=10485760

# OCR Configuration
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
TESSERACT_CMD=tesseract

# Machine Learning Runtime
MODEL_DIR=/app/ml/models
MODEL_VERSION=v1.0
DEVICE=cpu
